# Two turmites (packs/turmite) apart, against a plain simulation of each:
# Langton's ant (the pack's default rule) and an LLRR ant (`turns = 12,
# colours = 4`), set by the start. Langton's is still in its chaos at step
# 6000 (its highway starts near step 10 000: cell for cell to 12 000 when the
# pack was written); LLRR grows in place.
rules ../../packs/turmite
seed 1
size 128 128
terrain water_level 0 rock_on_soil 0 rock_on_water 0
start ant at (64, 64)
start ant at (110, 16) with (turns = 12, colours = 4)

run 2000                       # 1000 steps each
expect at (72, 58) ant         # Langton's
expect at (110, 16) ant        # LLRR, back where it started
expect count ink1 == 118       # all Langton's: LLRR has no colour 1 yet
expect count ink2 == 32
expect count ink3 == 24
run 10000                      # 6000 steps each
expect max steps of ant == 6000
expect at (66, 64) ant
expect at (110, 18) ant
expect count ink1 == 540       # 442 Langton's, 98 LLRR's
expect count ink2 == 92
expect count ink3 == 10
expect count ink4 == 0         # two colours and four: no fifth
expect traps ant == 0
