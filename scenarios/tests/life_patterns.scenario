# Life's classic patterns, on the pack in packs/life: a blinker turns over
# every generation, a block stays put, and a glider flies one cell down and one
# right every four generations, across the chunk border at x = 64.
rules ../../packs/life
seed 1
outside rock                   # beyond the board: rock, where nothing lives
start dead 1 / 1               # every board cell a dead one, but those drawn alive
map {
  ........................................................................
  ........................................................................
  .........OO..............................................O..............
  ...OOO...OO...............................................O.............
  ........................................................OOO.............
  ........................................................................
  ........................................................................
  ........................................................................
  ........................................................................
  ........................................................................
  ........................................................................
  ........................................................................
  ........................................................................
  ........................................................................
  ........................................................................
  ........................................................................
}
legend {
  . soil
  O alive
}

run 1
expect at (4, 2) alive         # the blinker stands up
expect at (4, 4) alive
expect at (3, 3) dead
expect at (5, 3) dead
expect count alive == 12       # 3 + 4 + 5, in every generation
run 1
expect at (3, 3) alive         # and lies down again
expect at (5, 3) alive
expect at (4, 2) dead
run 30                         # generation 32: the glider is 8 cells down and right,
expect at (65, 10) alive       # past the border
expect at (66, 11) alive
expect at (64, 12) alive
expect at (65, 12) alive
expect at (66, 12) alive
expect at (57, 2) dead
expect at (9, 2) alive         # the block has not moved
expect at (10, 3) alive
expect count alive == 12
expect at (80, 3) nobody       # rock beyond the board
