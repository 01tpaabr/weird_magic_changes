# Two arena packs that both declare a field `path`: packs/gather (the
# gatherers' footsteps) and packs/weather, whose `namespace weather` makes
# its own `weather.path` (the rain behind its clouds). Without the
# namespace the two would not load together.
#
#   make run ARGS="scenario scenarios/tests/weather.scenario"
rules ../../packs/gather ../../packs/weather
seed 5
size 192 128
terrain water_level 0 rock_on_soil 0 rock_on_water 0
start gatherer 1 / 300
start weather.cloud 1 / 600
run 1d
expect eventually max weather.path >= 100 to 2h   # rain under the clouds
expect eventually max path >= 16 to 6h             # the gatherers' footsteps
expect died gatherer == 0
expect traps weather.cloud == 0
expect count weather.cloud >= 30
