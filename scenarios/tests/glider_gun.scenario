# Gosper's glider gun (the pack is packs/life), the first pattern found that
# grows forever: every 30 generations it fires a glider down the diagonal,
# and an eater in the far corner swallows each one whole, so the board never
# fills. Gun and eater are as a plain Life puts them; the eater's place was
# found by trying every one near the gliders' path.
#
#   (scenarios/glider_gun.scenario plays it)
rules ../../packs/life
seed 1
outside rock                   # beyond the board: rock, where nothing lives
start dead 1 / 1               # every board cell a dead one, but those drawn alive
map {
  ..................................................
  .........................O........................
  .......................O.O........................
  .............OO......OO............OO.............
  ............O...O....OO............OO.............
  .OO........O.....O...OO...........................
  .OO........O...O.OO....O.O........................
  ...........O.....O.......O........................
  ............O...O.................................
  .............OO...................................
  ..................................................
  ..................................................
  ..................................................
  ..................................................
  ..................................................
  ..................................................
  ..................................................
  ..................................................
  ..................................................
  ..................................................
  ..................................................
  ..................................................
  ..................................................
  ..................................................
  ..................................................
  ..................................................
  ..................................................
  ..................................................
  ..................................................
  ..................................................
  ............................................OO....
  ............................................O.O...
  ..............................................O...
  ..............................................OO..
  ..................................................
  ..................................................
}
legend {
  . soil
  O alive
}

run 90                         # three gliders fired; the first is eaten
expect count alive == 58       # every 30 generations from here: the gun's phase, two gliders
run 30
expect count alive == 58
run 120                        # generation 240
expect count alive == 58
expect always count alive >= 58 from 90 to 240   # the gun never stalls
expect always count alive <= 85 from 90 to 240   # nor does the stream pile up
expect at (44, 30) alive       # the eater, whole
expect at (45, 30) alive
expect at (44, 31) alive
expect at (46, 33) alive
expect at (1, 5) alive         # and the gun's left block
expect at (2, 6) alive
