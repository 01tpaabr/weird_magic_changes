# Bees (docs/ACTORS.md step 6, the social primitives' acceptance test in
# sim.rs as data): a hive 28 cells from a patch of flowers round a pond,
# out of its sight. Its bees find the flowers, bring nectar home and dance
# the way; visited flowers set seed.
seed 21
size 64 64
outside soil
map {
  ........................................
  ........................................
  ........................................
  ............................*..*..*..*..
  ........................................
  ........................................
  ............................*.~~~~...*..
  ..............................~~~~......
  ..H...........................~~~~......
  ............................*.~~~~...*..
  ........................................
  ........................................
  ............................*..*..*..*..
  ........................................
  ........................................
  ........................................
}
legend {
  . soil
  ~ water
  * flower
  H hive
}

run 12h
expect count hive == 1
expect born bee >= 5               # the hive raised bees
expect born flower >= 1            # visited flowers set seed
expect count bee >= 1
