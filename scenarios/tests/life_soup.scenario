legend {
  . dead
  O alive
}

# The live cells of a plain Life on this soup, counted by an independent
# implementation at generations 0, 1, 2, 10, 50 and 100: the pack must play
# the same game.
expect count alive == 2433
run 1
expect count alive == 2574
run 1
expect count alive == 2116
run 8
expect count alive == 1494
run 40
expect count alive == 694
run 50
expect count alive == 557
expect count dead == 6355          # every board cell holds one actor, dead or alive
