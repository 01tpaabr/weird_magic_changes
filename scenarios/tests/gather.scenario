# The gather pack (packs/gather): fields. Gatherers harvest the ground's
# sugar into what they carry, eat from it, and take full loads home: some
# fill a load the first day, and few starve over three days.
#
#   make run ARGS="scenario scenarios/tests/gather.scenario"
#   make run ARGS="observe 3d --scenario scenarios/tests/gather.scenario"
rules ../../packs/gather
seed 5
size 192 128
terrain water_level 0 rock_on_soil 0 rock_on_water 0
start gatherer 1 / 300
run 3d
expect eventually max sugar of gatherer >= 20 from 1h to 1d  # a full load, harvested
expect mean avg sugar of gatherer >= 10 from 1d             # seen 13.6
expect always count gatherer >= 70                          # of 78; seen 77 at the least
expect traps gatherer == 0
