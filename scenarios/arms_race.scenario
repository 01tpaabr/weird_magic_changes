# Rabbits and wolves (packs/arms_race), both with a `speed` gene: watch the
# rabbits turn from cream to amber to pink as fast ones outrun the wolves, and
# the wolves, more slowly, from grey to orange as fast ones catch them.
#   wmc play saves/arms --scenario scenarios/arms_race.scenario
rules ../rules/lib.rules ../packs/arms_race
seed 7
size 192 192
terrain water_level 0.12 rock_on_soil 0.01 rock_on_water 0
start grass 1 / 3
start rabbit 1 / 60
start wolf 1 / 500
