legend {
  . soil
  # rock
  ~ water
  s seed
  C chicken
  F fox with (food = 10h)        # hungry from the start
  O alive
}

start head at (172, 2)           # the busy beaver's tape grows mostly to the left

start dead 1 / 1 in (194, 1) to (291, 64)        # the gun's board: its whole panel, 98 x 64

start hue0  1 / 16 in (293, 1) to (382, 64)
start hue1  1 / 16 in (293, 1) to (382, 64)
start hue2  1 / 16 in (293, 1) to (382, 64)
start hue3  1 / 16 in (293, 1) to (382, 64)
start hue4  1 / 16 in (293, 1) to (382, 64)
start hue5  1 / 16 in (293, 1) to (382, 64)
start hue6  1 / 16 in (293, 1) to (382, 64)
start hue7  1 / 16 in (293, 1) to (382, 64)
start hue8  1 / 16 in (293, 1) to (382, 64)
start hue9  1 / 16 in (293, 1) to (382, 64)
start hue10 1 / 16 in (293, 1) to (382, 64)
start hue11 1 / 16 in (293, 1) to (382, 64)
start hue12 1 / 16 in (293, 1) to (382, 64)
start hue13 1 / 16 in (293, 1) to (382, 64)
start hue14 1 / 16 in (293, 1) to (382, 64)
start hue15 1 / 16 in (293, 1) to (382, 64)

start spring 1 / 1 in (194, 66) to (321, 66)     # the top row picks again every SPRING_LIFE ticks
start unset 1 / 1 in (194, 67) to (321, 131)
start spring at (258, 66) with (odds = 100)      # the apex, always lit: 64 cells from the left edge

start ant at (356, 104)                              # Langton's
start ant at (334, 78) with (turns = 12, colours = 4)   # LLRR

start bud at (210, 214)
start bud at (236, 214) with (sleep = 25)
start bud at (264, 214) with (sleep = 50)
start bud at (290, 214) with (sleep = 75)

start grass 1 / 1 in (313, 133) to (382, 214)    # the pen's meadow: every walkable cell

# Side by side, each world as it is alone (the numbers from plain
# simulations of the machine, the automaton and the ants):
run 720
expect at (166, 29) head         # its 347th step written, a tick before it moves on to (165, 29)
expect count lit == 731          # rule 90's first 66 rows, redrawn once (its springs picked again at about 386)
expect count alive == 73         # the gun at generation 720, a multiple of its period
expect at (352, 102) ant         # Langton's, 360 steps in
expect at (332, 80) ant          # LLRR
expect count ink1 == 106         # 62 Langton's, 44 LLRR's
expect count ink2 == 5
expect count bud == 0            # four trees grown
expect count bark == 52          # 13 cells of trunk each
expect count fox == 1
expect count chicken >= 12
expect traps head == 0
expect traps ant == 0
expect traps unset == 0
expect traps alive == 0
expect traps bud == 0
expect traps fox == 0
expect traps chicken == 0
