  F fox with (food = 10h)        # hungry from the start
  H hive
  O alive
}

# The farm: on each walkable cell one of these, grass on all the rest (the
# shares add up to 1).
start chicken 1 / 256 in (1, 1) to (192, 214)
start seed    1 / 128 in (1, 1) to (192, 214)
start flower  1 / 512 in (1, 1) to (192, 214)  # few at first: they spread, and the animals stand out
start grass 505 / 512 in (1, 1) to (192, 214)

start origin at (370, 131)       # the busy beaver starts over here when its head meets a wall
start head at (370, 132)         # its tape grows mostly to the left: the wall at step 1034

start dead 1 / 1 in (194, 1) to (321, 64)        # the Life board: its whole panel, 128 x 64

start hue0  1 / 16 in (323, 1) to (382, 64)
start hue1  1 / 16 in (323, 1) to (382, 64)
start hue2  1 / 16 in (323, 1) to (382, 64)
start hue3  1 / 16 in (323, 1) to (382, 64)
start hue4  1 / 16 in (323, 1) to (382, 64)
start hue5  1 / 16 in (323, 1) to (382, 64)
start hue6  1 / 16 in (323, 1) to (382, 64)
start hue7  1 / 16 in (323, 1) to (382, 64)
start hue8  1 / 16 in (323, 1) to (382, 64)
start hue9  1 / 16 in (323, 1) to (382, 64)
start hue10 1 / 16 in (323, 1) to (382, 64)
start hue11 1 / 16 in (323, 1) to (382, 64)
start hue12 1 / 16 in (323, 1) to (382, 64)
start hue13 1 / 16 in (323, 1) to (382, 64)
start hue14 1 / 16 in (323, 1) to (382, 64)
start hue15 1 / 16 in (323, 1) to (382, 64)

start spring 1 / 1 in (194, 66) to (321, 66)     # the top row picks again every SPRING_LIFE ticks
start unset 1 / 1 in (194, 67) to (321, 129)    # 64 rows: the triangle meets both edges on its last
start spring at (258, 66) with (odds = 100)      # the apex, always lit: 64 cells from the left edge

start ant at (356, 104)                              # Langton's
start ant at (334, 78) with (turns = 12, colours = 4)   # LLRR

start bud at (222, 214) with (trunk = 25)                 # trees as tall as their box: 84 rows
start bud at (258, 214) with (trunk = 25, sleep = 30)
start bud at (294, 214) with (trunk = 25, sleep = 60)


# Side by side, each world as it is alone (the numbers from plain
# simulations of the machine, the automaton and the ants):
run 720
expect at (364, 159) head        # its 347th step written, a tick before it moves on to (363, 159)
expect count lit == 729          # rule 90's first 64 rows, 3^6, redrawn once (its springs picked again at about 386)
expect count alive == 350        # Life at generation 720, a multiple of its period (120): as a plain Life has it
expect at (352, 102) ant         # Langton's, 360 steps in
expect at (332, 80) ant          # LLRR
expect count ink1 == 106         # 62 Langton's, 44 LLRR's
expect count ink2 == 5
expect count bud == 0            # three trees grown
expect count bark == 78          # 26 cells of trunk each
expect count fox == 6            # the farm: its foxes, its hives, its flock and flowers
expect count hive == 3
expect count chicken >= 60
expect count flower >= 50         # few at first, spreading
expect traps head == 0
expect traps ant == 0
expect traps unset == 0
expect traps alive == 0
expect traps bud == 0
expect traps fox == 0
expect traps chicken == 0
