# workshop: a search over memory (docs/RULES.md §12, Searches). Carpenters
# don't follow a fixed order of chores: each think a search plans, over
# what it carries (wood, planks), the cheapest way to its next hut, and
# the plan's first step is what it does now: fetch wood, saw two into a
# plank, or build when it holds four planks. Trees are a field that grows
# back; huts are a feature they build beside them.
# scenarios/tests/workshop.scenario plays it.

const CHOP = 1
const SAW = 2
const BUILD = 3

field trees max 9 conserved {
  init noise scale 8
  color "#2f8f3f"
  every 2h { trees = min(trees + 1, 9) }
}
feature hut { blocks  glyph "^"  color "#c08040" }

kind carpenter {
  glyph "c"
  color "#f0d0a0"
  cadence 4
  sight 8
  fuel 16384
  need trees max 20 decay 0          # the wood it carries
  mem planks, huts, sawn, born, wrong   # wrong: a chore done without the means (never)

  search next_hut {
    state w, p, h = trees, planks, 0
    next {
      try w + 1, p, h cost 2 via CHOP
      if w >= 2 { try w - 2, p + 1, h cost 1 via SAW }
      if p >= 4 { try w, p - 4, h + 1 cost 3 via BUILD }
    }
    goal h >= 1
    guess 4 - min(p, 4)
    limit 400
  }

  when born == 0 => { born = 1  trees = 0  idle }   # needs start full: empty-handed
  when next_hut() as job => {
    if job.via == SAW {
      if trees < 2 { wrong += 1 }
      trees -= 2  planks += 1  sawn += 1  idle
    }
    else if job.via == BUILD and free(east) {
      if planks < 4 { wrong += 1 }
      planks -= 4  huts += 1  build hut at east
    }
    else if job.via == CHOP and trees(here) > 0 { harvest trees 1 }
    else if best trees on free within 8 as t { move toward t }
    else { move random free }
  }
  when true => move random free
}
