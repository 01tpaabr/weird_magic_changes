# Budders: kinds that only bud, for watching genes pass from parent to child
# (scenarios/tests/genes_inherit and genes_drift). A budder buds into a free
# neighbouring cell while fewer than twelve of its kind stand within its `reach`,
# and dies of age after a day, so a world of them turns over a generation about
# every day. `reach` is a gene: each budder has its own and a child starts with
# its parent's. A budder passes it on exactly; a drifter's moves a step in
# every birth (`mutate 100`), so selection has something to work on.

kind budder {
  glyph "b"
  color "#9fd36b"
  cadence 256
  sight 10
  gene reach = 5 from 1 to 10     # how far it looks for crowding
  when age > 1d => die
  when count budder within reach < 12 and nearest free within 1 as c => spawn budder at c
}

kind drifter {
  glyph "d"
  color "#d3a06b"
  cadence 256
  sight 10
  gene reach = 5 from 1 to 10 mutate 100
  when age > 1d => die
  when count drifter within reach < 12 and nearest free within 1 as c => spawn drifter at c
}
