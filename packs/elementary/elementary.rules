# An elementary cellular automaton, as a pack, drawn as its history: each row
# of the world is the generation after the row above it. A cell of a row is
# decided by the three cells above it (left, centre, right), by Wolfram's rule
# number: bit L * 4 + C * 2 + R of RULE says whether it is lit. Rule 90 from a
# single lit cell draws the Sierpinski triangle (scenarios/elementary.scenario);
# `--set RULE=30` is chaos, `--set RULE=110` is Turing complete.
#
# Every cell starts `unset` and waits for the three above it; then it is lit
# or unlit for as long as they stay decided. Above the top row nothing is lit.
#
# A board can flow instead of stand: give its top row `spring`s. A spring
# lights with `odds` chances in 100 (its memory: `with (odds = 100)` always),
# holds for SPRING_LIFE ticks, then picks again; a cell whose parent goes
# back to unset goes back too, so each pick erases the board in a wave from
# the top and redraws it right behind, the colour bands one step on
# (scenarios/gallery.scenario).

const RULE = 90
const ROW_CADENCE = 2        # an unset cell looks up every 2 ticks, staggered: a ragged front
const BAND = 8               # rows of one colour of lit cells
const SPRING_LIFE = 384      # ticks a spring holds before it picks again

trait row_cell {
  cover
  solid                      # a pixel of the picture
  sight 1
}

kind unset extends row_cell {
  glyph ","
  color "#30303a"
  cadence ROW_CADENCE

  when is(at(x - 1, y - 1), unset) or is(north, unset) or is(at(x + 1, y - 1), unset) => idle
  when true => {
    let v = RULE
    repeat is(at(x - 1, y - 1), lit) * 4 + is(north, lit) * 2 + is(at(x + 1, y - 1), lit) { v = v / 2 }
    look = look_of(north)    # the generation above: its colours
    if v % 2 == 1 { shine(y / BAND + look_of(north)) } else { become unlit }
  }
}

# A lit cell, coloured by its band of rows.
sub shine(band) {
  let b = band % 6
  if b == 0 { become lit } else if b == 1 { become lit_1 } else if b == 2 { become lit_2 }
  else if b == 3 { become lit_3 } else if b == 4 { become lit_4 } else { become lit_5 }
}

# A decided cell: back to unset as soon as a parent is (it looks every tick,
# so it never misses one).
trait decided extends row_cell {
  cadence 1
  when is(at(x - 1, y - 1), unset) or is(north, unset) or is(at(x + 1, y - 1), unset) => become unset
}

kind unlit extends decided { glyph "."  color "#14141c" }
kind lit   extends decided { glyph "#"  color "#ff6b6b" }
kind lit_1 extends lit     { glyph "#"  color "#ffb347" }
kind lit_2 extends lit     { glyph "#"  color "#f5e663" }
kind lit_3 extends lit     { glyph "#"  color "#6be37b" }
kind lit_4 extends lit     { glyph "#"  color "#5ab8ff" }
kind lit_5 extends lit     { glyph "#"  color "#b57bff" }

# A spring and what it picked. Its `epoch` counts its picks; its look carries
# it down the board, where it shifts the colour bands.
trait source {
  mem odds, epoch
}

kind spring extends unset, source {
  glyph "^"
  when true => {
    epoch += 1
    look = epoch % 6
    if chance(odds) { become spring_lit } else { become spring_unlit }
  }
}

kind spring_lit extends lit, source {
  glyph "^"
  when age >= SPRING_LIFE => become spring
}

kind spring_unlit extends unlit, source {
  glyph "^"
  when age >= SPRING_LIFE => become spring
}
