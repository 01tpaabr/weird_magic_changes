# The fast tier of goal.scenario, for iterating: the same world and the same
# 16 days on 192x192 (0.56 of the area, ~1.6x faster), each threshold taken
# from this world's own baseline the way goal.scenario takes its own. It is
# harsher than the full goal (fewer founders: hens die out on 2 seeds of 8,
# foxes on 3); goal.scenario decides.
rules ../../rules
seed 42
seeds 8
pass 7
size 192 192
terrain water_scale 12 water_level 0.30 rock_on_soil 0.04 rock_on_water 0.01
start chicken 1 / 400
start fox     1 / 5000
start flower  1 / 250
start hive    1 / 20000
start grass   1 / 20
start seed    1 / 100

run 16d
expect mean eaten chicken by fox per day >= 21 from 2d   # twice this baseline's 10.4 a day (7.9 .. 16.7)
expect mean eaten chicken by fox per day >= 9 from 9d    # twice its 4.4 (0 .. 21.3)
expect always count chicken >= 60 from 2d                # half its usual lowest (122; 0 on seeds 42 and 43)
expect always count fox >= 2 from 2d                     # its lowest is 0 .. 3, median 1
