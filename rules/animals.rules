# Animals: hens, their eggs and chicks, and the fox. The subs and traits they
# share (`walker`, `drinker`, `mortal`, `flee`, `forage`, ...) are in
# lib.rules. Kinds are numbered in pre-order over the inheritance forest,
# files in name order: chicken 0, chick 1 (it extends chicken), egg 2, fox 3,
# flower 4, hive 5, bee 6, grass 7, seed 8, tree 9.

# What hens and chicks do alike, in this order: run when hurt, drink when
# desperate (fox or not), flee a fox, find and drink water (a drinker, which
# walks round what blocks it), eat.
trait fowl extends drinker(6, 90min, 3) {
  need food max 1d vital

  when hurt > 0                    => { detour = 0  flee(attacker) }
  when water < 30min and nearest water within 1 as w => drink w     # desperate: drinks, fox or not
  when nearest fox within 5 as f   => flee(f)
  inherit drinker                                                   # remembers water, detours, drinks below 90min
  when food < 20h and nearest seed within 1 as s => eat s           # a seed at its feet
  when food < 20h                  => forage(grass, 6)              # falls through when there is none
  when food < 20h                  => peck(seed, 6)
}

kind chicken extends mortal(5d, 6), fowl {
  glyph "C"
  color "#f2ead8"                   # a white hen
  tags animal meat
  cadence 4                         # thinks every 4 ticks (16 game seconds)
  sight 6
  food 1d                           # what an eater gains: a fox's day
  need health max 20 decay 0 vital
  mem last_egg

  inherit mortal                                                    # old age: ~5 days as a hen, then ~3 more on average
  inherit fowl
  when hour >= 6 and hour < 18 and food > 20h and water > 1h and day + 1 > last_egg and rand(1000) < 2
       and count feed within 5 >= 6 and count meat within 6 < 3
       and nearest free within 1 as c => { last_egg = day + 3  spawn egg at c }   # an egg every 3 days at most: by day, fed, food around, room to nest; ~2h in
  when hour >= 20 or hour < 5      => { look = 1  idle }                          # roosts at night
  when chance(10) and nearest only chicken within 6 as m and dist(m) > 5 => { look = 0  move toward m }   # drifts toward other hens, loosely
  when true                        => { look = 0  wander() }
}

kind egg {
  glyph "o"
  color "#fff8e7"
  tags meat
  cadence 64
  food 4h
  need health max 3 decay 0 vital
  when age > 8h => become chick
}

# A chick is a chicken that has not grown up: fowl's rules and none of a
# hen's own (no eggs, no roosting), and it potters rather than walks.
kind chick extends chicken {
  glyph "c"
  color "#f5d547"                   # yellow
  food 8h
  need health max 6 decay 0 vital
  sub wander() { heading = turn(heading)  if chance(50) { move dir(heading) } else { idle } }   # half its thinks it stays put

  when age > 2d                    => become chicken
  inherit fowl
  when nearest only chicken within 6 as m and dist(m) > 1 => move toward m   # follows a hen, not another chick
  when true                        => wander()
}

kind fox extends mortal(6d, 3), drinker(8, 6h, 2) {
  glyph "F"
  color "#e8792b"                   # orange
  tags animal
  cadence 2                         # twice a chicken's pace: a chase can end
  sight 16                          # knows its whole territory
  bite 10                           # two bites kill a chicken
  food 1d
  need food   max 1d vital
  need water  max 1d vital          # the drinker's water, holding a day
  need health max 40 decay 0 vital
  mem prey_x, prey_y, chase, last_litter

  inherit mortal                                                    # old age: ~6 days, then ~3 more on average
  when true                        => look = 0                      # awake, unless it sleeps below; falls through
  inherit drinker                                                   # remembers water within 8, drinks below 6h
  when food < 20h and nearest meat within 1 as m => { chase = 0  eat m }
  when food < 20h and nearest meat within 8 as m
       => { prey_x = x + m.dx  prey_y = y + m.dy  chase = 30  move toward m }
  when food < 20h and chase > 0 and dist(at(prey_x, prey_y)) > 0
       => { chase -= 1  move toward at(prey_x, prey_y) }            # to where it last saw prey
  when hour >= 9 and hour < 17 and food >= 12h => { look = 1  idle }   # sleeps through the day when fed
  when age > 2d and food > 20h and day + 1 > last_litter and chance(2)
       and count fox within 16 < 2 and count only chicken within 16 >= 15   # hens, not chicks: counting chicks let foxes boom
       and nearest free within 1 as c => { last_litter = day + 5  spawn fox at c }  # a kit every 5 days: fed, its own ground, prey on it
  when true                        => wander()                      # patrols
}
