# Plants: seeds that grow into trees where there is water and room, and
# trees that drop seeds. Both are `rooted` (lib.rules); see docs/RULES.md for
# the language.

kind seed extends rooted(2, 1d, 1d) {
  glyph ","
  color "#7a3b12"                   # chestnut: reads on the soil
  tags plant feed                   # chickens graze `feed`
  cadence 512                       # a think every ~34 game minutes, 42 a day
  sight 2
  food 3h                           # what an eater gains
  need health max 1 decay 0 vital   # one bite
  mem lit

  inherit rooted                    # water within 2 keeps it; a day away from it dries a seed out
  when light > 0                => lit += 1                 # bookkeeping: falls through
  when lit >= 20 and count tree within 2 < 3 and count water within 1 == 0
                                => become tree              # ~20 lit thinks; not in thick woods, not on the shore
}

kind tree extends rooted(2, 3d, 3d) {
  glyph "T"
  color "#3f9e4d"
  tags plant
  cadence 512
  sight 2
  need health max 100 decay 0 vital
  mem sun

  inherit rooted                    # water within 2 keeps it three days
  when light > 128 and water > 1d => sun += 1
  when sun >= 4 and nearest free within 2 as c => { sun = 0; spawn seed at c }    # a seed per ~4 sunny thinks: ~5 a day
}
